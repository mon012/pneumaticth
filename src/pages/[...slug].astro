---
import BaseLayout from '../layouts/BaseLayout.astro';
import pages from '../data/pages.json';
import footerHtml from '../data/footer.html?raw';
import imageVariants from '../data/image-variants.json';
import { mustReplace, youtubeFacade, hasYoutube, breadcrumbTrail, withBreadcrumb, withFaq, responsiveImages } from '../lib/content.js';

export function getStaticPaths() {
  return pages.map((page) => ({ params: { slug: page.route || undefined }, props: page }));
}

const page = Astro.props;
const industrialCard = `
<div class="gb-grid-column industrial-products-card-column"><div class="gb-container industrial-product-card">

<p class="gb-headline"></p>

<h3 class="gb-headline gb-headline-text">สินค้าอุตสาหกรรมอื่นๆ</h3>

<a class="gb-button gb-button-text" href="/industrial-products/">ดูสินค้าอุตสาหกรรมอื่นๆ</a>

</div></div>`;
const homeCardAnchor = `<a class="gb-button gb-button-9b792ea7 gb-button-text" href="/filter/">ดูไส้กรองอุตสาหกรรม</a>

</div></div>`;
// mustReplace throws at build time if the fragment stops matching, so a content
// change in pages.json can never silently drop the industrial products card.
const rawHtml = !page.route
  ? mustReplace(page.html, homeCardAnchor, `${homeCardAnchor}\n\n${industrialCard}`, 'home: industrial products card')
  : page.html;
// responsiveImages runs last so the hero <img> read below already carries the
// srcset/sizes that BaseLayout preloads.
const pageHtml = responsiveImages(
  withFaq(withBreadcrumb(youtubeFacade(rawHtml), breadcrumbTrail(page.route || '', page.title)), page.faq),
  imageVariants,
);
// The first <img> of a page is its hero (LCP). Pass its srcset/sizes along so the
// <link rel=preload> in BaseLayout picks the SAME candidate the layout will use —
// preloading without them downloads the full-size file on every device.
const heroTag = pageHtml.match(/<img[^>]*>/i)?.[0] ?? '';
const ogImage = heroTag.match(/\ssrc="([^"]+)"/)?.[1];
const heroSrcset = heroTag.match(/\ssrcset="([^"]+)"/)?.[1];
const heroSizes = heroTag.match(/\ssizes="([^"]+)"/)?.[1];
---
<BaseLayout
  title={page.title}
  description={page.description}
  canonical={page.canonical}
  isHome={!page.route}
  footerHtml={footerHtml}
  ogImage={ogImage}
  heroSrcset={heroSrcset}
  heroSizes={heroSizes}
  route={page.route || ''}
  faq={page.faq}
  lastmod={page.lastmod}
  datePublished={page.datePublished}
  hasVideo={hasYoutube(pageHtml)}
>
  <article class="legacy-content" set:html={pageHtml} />
</BaseLayout>
