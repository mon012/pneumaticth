---
import BaseLayout from '../layouts/BaseLayout.astro';
import footerHtml from '../data/footer.html?raw';
import { breadcrumbTrail, breadcrumbHtml } from '../lib/content.js';

// Written for the queries this page actually earns impressions on in Search
// Console (MPa → bar, N → kg, L/s and m³/h → CFM), so the snippet answers
// them by name instead of listing unit families.
const title = 'แปลงหน่วย MPa เป็น bar, N เป็น kg, L/s เป็น CFM | ตารางแปลงหน่วยวิศวกรรม';
const description =
  '1 MPa = 10 bar, 1 kgf = 9.80665 N, 1 L/s = 2.119 CFM — แปลงหน่วยความดัน แรง อัตราการไหล กำลัง แรงบิด และอุณหภูมิได้ทันที พร้อมตารางค่าที่ใช้บ่อยในงานนิวเมติกและลมอัด';

/**
 * Unit data — the single source for BOTH the static reference tables rendered
 * below and the interactive converter, so the two can never disagree.
 *
 * `factor` is how many base units one of this unit is worth. The base of each
 * category is the unit Thai factory teams actually quote in, not the SI unit:
 * quoting pressure against bar keeps "1 psi = 0.0689476 bar" readable, where
 * against the pascal it would read 6894.76 and help nobody.
 *
 * Temperature carries offsets rather than a factor, so it is flagged and
 * handled separately in the table below and in the client script.
 */
const CATEGORIES = [
  {
    id: 'pressure',
    name: 'ความดัน',
    base: 'bar',
    units: [
      { sym: 'bar', name: 'บาร์', factor: 1 },
      { sym: 'psi', name: 'ปอนด์ต่อตารางนิ้ว', factor: 0.0689475729317 },
      { sym: 'kgf/cm²', name: 'กิโลกรัมแรงต่อตารางเซนติเมตร', factor: 0.980665 },
      { sym: 'MPa', name: 'เมกะปาสคาล', factor: 10 },
      { sym: 'N/mm²', name: 'นิวตันต่อตารางมิลลิเมตร (= MPa)', factor: 10 },
      { sym: 'kPa', name: 'กิโลปาสคาล', factor: 0.01 },
      { sym: 'Pa', name: 'ปาสคาล', factor: 0.00001 },
      { sym: 'mbar', name: 'มิลลิบาร์', factor: 0.001 },
      { sym: 'atm', name: 'บรรยากาศ', factor: 1.01325 },
      { sym: 'mmHg', name: 'มิลลิเมตรปรอท', factor: 0.00133322387415 },
      { sym: 'mmH₂O', name: 'มิลลิเมตรน้ำ', factor: 0.0000980665 },
    ],
  },
  {
    id: 'force',
    name: 'แรง',
    base: 'N',
    units: [
      { sym: 'N', name: 'นิวตัน', factor: 1 },
      { sym: 'kgf', name: 'กิโลกรัมแรง', factor: 9.80665 },
      { sym: 'kN', name: 'กิโลนิวตัน', factor: 1000 },
      { sym: 'lbf', name: 'ปอนด์แรง', factor: 4.4482216152605 },
      { sym: 'tonf', name: 'ตันแรง (เมตริก)', factor: 9806.65 },
      { sym: 'dyn', name: 'ดายน์', factor: 0.00001 },
    ],
  },
  {
    id: 'flow',
    name: 'อัตราการไหล',
    base: 'L/min',
    units: [
      { sym: 'L/min', name: 'ลิตรต่อนาที', factor: 1 },
      { sym: 'CFM', name: 'ลูกบาศก์ฟุตต่อนาที', factor: 28.316846592 },
      { sym: 'm³/h', name: 'ลูกบาศก์เมตรต่อชั่วโมง', factor: 16.6666666667 },
      { sym: 'm³/min', name: 'ลูกบาศก์เมตรต่อนาที', factor: 1000 },
      { sym: 'L/s', name: 'ลิตรต่อวินาที', factor: 60 },
      { sym: 'GPM', name: 'แกลลอนสหรัฐต่อนาที', factor: 3.785411784 },
    ],
  },
  {
    id: 'power',
    name: 'กำลัง',
    base: 'kW',
    units: [
      { sym: 'kW', name: 'กิโลวัตต์', factor: 1 },
      { sym: 'HP', name: 'แรงม้า (อังกฤษ)', factor: 0.7456998715823 },
      { sym: 'PS', name: 'แรงม้า (เมตริก)', factor: 0.73549875 },
      { sym: 'W', name: 'วัตต์', factor: 0.001 },
      { sym: 'kcal/h', name: 'กิโลแคลอรีต่อชั่วโมง', factor: 0.001163 },
      { sym: 'BTU/h', name: 'บีทียูต่อชั่วโมง', factor: 0.00029307107 },
    ],
  },
  {
    id: 'torque',
    name: 'แรงบิด',
    base: 'N·m',
    units: [
      { sym: 'N·m', name: 'นิวตันเมตร', factor: 1 },
      { sym: 'kgf·m', name: 'กิโลกรัมแรงเมตร', factor: 9.80665 },
      { sym: 'kgf·cm', name: 'กิโลกรัมแรงเซนติเมตร', factor: 0.0980665 },
      { sym: 'lbf·ft', name: 'ปอนด์แรงฟุต', factor: 1.3558179483314 },
      { sym: 'lbf·in', name: 'ปอนด์แรงนิ้ว', factor: 0.1129848290276 },
    ],
  },
  {
    id: 'length',
    name: 'ความยาว',
    base: 'mm',
    units: [
      { sym: 'mm', name: 'มิลลิเมตร', factor: 1 },
      { sym: 'cm', name: 'เซนติเมตร', factor: 10 },
      { sym: 'm', name: 'เมตร', factor: 1000 },
      { sym: 'inch', name: 'นิ้ว', factor: 25.4 },
      { sym: 'ft', name: 'ฟุต', factor: 304.8 },
    ],
  },
  {
    id: 'volume',
    name: 'ปริมาตร',
    base: 'L',
    units: [
      { sym: 'L', name: 'ลิตร', factor: 1 },
      { sym: 'm³', name: 'ลูกบาศก์เมตร', factor: 1000 },
      { sym: 'mL', name: 'มิลลิลิตร', factor: 0.001 },
      { sym: 'ft³', name: 'ลูกบาศก์ฟุต', factor: 28.316846592 },
      { sym: 'gal', name: 'แกลลอนสหรัฐ', factor: 3.785411784 },
    ],
  },
  {
    id: 'temperature',
    name: 'อุณหภูมิ',
    base: '°C',
    temperature: true,
    units: [
      { sym: '°C', name: 'องศาเซลเซียส' },
      { sym: '°F', name: 'องศาฟาเรนไฮต์' },
      { sym: 'K', name: 'เคลวิน' },
    ],
  },
];

/** Trim a factor to 7 significant digits without turning 1000 into 1. */
function fmt(n) {
  if (n === 0) return '0';
  const abs = Math.abs(n);
  if (abs < 1e-6 || abs >= 1e9) return n.toExponential(4);
  let s = n.toPrecision(7);
  if (s.includes('.')) s = s.replace(/0+$/, '').replace(/\.$/, '');
  const [whole, dec] = s.split('.');
  return Number(whole).toLocaleString('en-US') + (dec ? `.${dec}` : '');
}

/** Fixed reference points, since temperature converts by offset not by ratio. */
const TEMPERATURE_ROWS = [-40, 0, 20, 40, 100].map((c) => ({
  c,
  f: fmt(c * 9 / 5 + 32),
  k: fmt(c + 273.15),
}));

/**
 * Worked answers for the exact conversions people search for. Computed from
 * CATEGORIES rather than typed in, so a quick answer can never drift from the
 * converter that sits above it.
 */
const unitIn = (categoryId, sym) => {
  const unit = CATEGORIES.find((c) => c.id === categoryId).units.find((u) => u.sym === sym);
  if (!unit) throw new Error(`[converter] unknown unit ${categoryId}/${sym}`);
  return unit;
};
const convertFixed = (categoryId, value, from, to) =>
  (value * unitIn(categoryId, from).factor) / unitIn(categoryId, to).factor;

const QUICK_ANSWERS = [
  { id: 'mpa-bar', title: 'MPa เป็น bar', category: 'pressure', from: 'MPa', to: 'bar', values: [0.1, 0.2, 0.5, 0.7, 1, 1.6, 10, 20] },
  { id: 'nmm2-kgfcm2', title: 'N/mm² เป็น kgf/cm²', category: 'pressure', from: 'N/mm²', to: 'kgf/cm²', values: [1, 5, 10, 20, 30] },
  { id: 'bar-psi', title: 'bar เป็น psi', category: 'pressure', from: 'bar', to: 'psi', values: [1, 4, 6, 7, 8, 10] },
  { id: 'n-kgf', title: 'N (นิวตัน) เป็น kg (kgf)', category: 'force', from: 'N', to: 'kgf', values: [1, 10, 100, 500, 1000] },
  { id: 'ls-cfm', title: 'L/s เป็น CFM', category: 'flow', from: 'L/s', to: 'CFM', values: [1, 5, 10, 50, 100] },
  { id: 'm3h-cfm', title: 'm³/h เป็น CFM', category: 'flow', from: 'm³/h', to: 'CFM', values: [1, 10, 60, 100, 500] },
  { id: 'cfm-m3min', title: 'CFM เป็น m³/min', category: 'flow', from: 'CFM', to: 'm³/min', values: [1, 10, 50, 100, 500] },
  { id: 'cfm-m3h', title: 'CFM เป็น m³/h (CMH)', category: 'flow', from: 'CFM', to: 'm³/h', values: [1, 10, 100, 500, 1000] },
  { id: 'gpm-lmin', title: 'GPM เป็น L/min (ลิตร)', category: 'flow', from: 'GPM', to: 'L/min', values: [1, 5, 10, 50] },
].map((q) => ({ ...q, rows: q.values.map((v) => [fmt(v), fmt(convertFixed(q.category, v, q.from, q.to))]) }));

/**
 * One list feeds both the visible FAQ and the FAQPage node BaseLayout emits,
 * the same pairing the WordPress articles get through pages.json.
 */
const FAQ = [
  {
    q: '1 MPa เท่ากับกี่ bar',
    a: '1 MPa = 10 bar และ 1 bar = 0.1 MPa เช่น 0.2 MPa = 2 bar, 1.6 MPa = 16 bar, 20 MPa = 200 bar สเปกอุปกรณ์นิวเมติกจากญี่ปุ่นอย่าง SMC และ CKD มักระบุความดันเป็น MPa ส่วนเกจในโรงงานไทยส่วนใหญ่อ่านเป็น bar',
  },
  {
    q: 'แปลง N เป็น kg (kgf) ทำอย่างไร',
    a: 'หารด้วย 9.80665 เช่น 100 N = 10.197 kgf และแปลงกลับด้วยการคูณ 9.80665 เช่น 10 kgf = 98.0665 N ข้อควรระวังคือ kg เป็นหน่วยมวล ส่วน kgf (กิโลกรัมแรง) เป็นหน่วยแรง การแปลงนี้ใช้ได้เมื่อพูดถึงน้ำหนักภายใต้แรงโน้มถ่วงปกติ',
  },
  {
    q: 'แปลง L/s เป็น CFM ทำอย่างไร',
    a: 'คูณด้วย 2.11888 เช่น 10 L/s = 21.19 CFM และ 1 CFM = 0.4719 L/s เครื่องอัดลมสกรูจากยุโรปมักระบุอัตราลมเป็น L/s ส่วนสเปกจากอเมริกาใช้ CFM',
  },
  {
    q: 'แปลง m³/h เป็น CFM ทำอย่างไร',
    a: 'คูณด้วย 0.5886 เช่น 100 m³/h = 58.86 CFM และ 1 CFM = 1.699 m³/h',
  },
  {
    q: '1 CFM เท่ากับกี่ m³/min',
    a: '1 CFM = 0.02832 m³/min และ 1 m³/min = 35.31 CFM เช่น เครื่องอัดลมขนาด 100 CFM ผลิตลมได้ประมาณ 2.83 m³/min',
  },
  {
    q: '1 CFM เท่ากับกี่ CMH (m³/h)',
    a: '1 CFM = 1.699 m³/h (CMH) และ 1 m³/h = 0.5886 CFM หน่วย CMH ใช้บ่อยในงานระบบระบายอากาศและพัดลม',
  },
  {
    q: 'สูตรคำนวณ CFM คืออะไร',
    a: 'CFM คือปริมาตรลมเป็นลูกบาศก์ฟุตต่อนาที แปลงจากหน่วยอื่นได้ดังนี้ CFM = L/s × 2.119, CFM = m³/min × 35.31, CFM = m³/h × 0.5886 และ CFM = L/min × 0.03531 ถ้าจะคำนวณความต้องการลมของโรงงาน ให้รวมอัตราลมของอุปกรณ์ทุกตัวที่ทำงานพร้อมกัน แล้วเผื่อเพิ่มราว 20–30% สำหรับลมรั่วและการขยายไลน์',
  },
  {
    q: 'CFM, SCFM และ FAD ต่างกันอย่างไร',
    a: 'CFM คือปริมาตรลมที่สภาวะจริง ณ จุดวัด SCFM คือปริมาตรที่ปรับเป็นสภาวะมาตรฐาน (ความดัน อุณหภูมิ และความชื้นที่กำหนด) ส่วน FAD (Free Air Delivery) คือปริมาณลมที่เครื่องอัดลมส่งออกได้จริง คิดกลับเป็นสภาวะอากาศขาเข้าตามมาตรฐาน ISO 1217 เวลาเทียบสเปกเครื่องอัดลมต่างยี่ห้อ ควรเทียบค่า FAD ที่ความดันเดียวกัน ไม่ใช่ค่าปริมาตรกระบอกสูบ (Displacement) ซึ่งสูงกว่าลมที่ได้จริง',
  },
  {
    q: 'N คือหน่วยอะไร',
    a: 'N (นิวตัน) คือหน่วยของแรงในระบบ SI หมายถึงแรงที่ทำให้มวล 1 กิโลกรัมมีความเร่ง 1 เมตรต่อวินาทีกำลังสอง ของที่มีมวล 1 kg บนโลกจะมีน้ำหนักประมาณ 9.81 N หรือเท่ากับ 1 kgf',
  },
  {
    q: 'แปลง N/mm² เป็น kgf/cm² ทำอย่างไร',
    a: '1 N/mm² = 1 MPa = 10.197 kgf/cm² ดังนั้นให้คูณด้วย 10.197 เช่น 25 N/mm² = 254.9 kgf/cm² หน่วย N/mm² ใช้บ่อยกับกำลังรับแรงของวัสดุและคอนกรีต',
  },
  {
    q: '1 GPM เท่ากับกี่ลิตร',
    a: '1 GPM (แกลลอนสหรัฐต่อนาที) = 3.785 ลิตรต่อนาที ใช้บ่อยกับสเปกปั๊มไฮดรอลิคและปั๊มน้ำ',
  },
  {
    q: '1 bar เท่ากับกี่ psi',
    a: '1 bar = 14.504 psi และ 1 psi = 0.0689 bar ระบบลมอัดโรงงานทั่วไปตั้งไว้ราว 6–7 bar หรือประมาณ 87–102 psi',
  },
  {
    q: 'kgf/cm² กับ bar ต่างกันอย่างไร',
    a: '1 kgf/cm² = 0.980665 bar ต่างกันประมาณ 2% ในงานหน้างานจึงมักใช้แทนกันได้โดยประมาณ แต่ถ้าเป็นการตั้งค่าเซฟตี้วาล์วหรือคำนวณตามสเปกควรใช้ค่าจริง',
  },
  {
    q: '1 atm เท่ากับกี่ mmHg',
    a: '1 atm = 760 mmHg = 1.01325 bar = 14.696 psi',
  },
];

const defaultCategory = CATEGORIES[0];
const trail = breadcrumbTrail('engineer-unit-converter', 'แปลงหน่วยวิศวกรรม');
---

<BaseLayout
  title={title}
  description={description}
  canonical="/engineer-unit-converter/"
  route="engineer-unit-converter"
  footerHtml={footerHtml}
  faq={FAQ}
  breadcrumbName="แปลงหน่วยวิศวกรรม"
>
  <article class="converter-page">
    <Fragment set:html={breadcrumbHtml(trail)} />

    <header class="converter-header">
      <h1>แปลงหน่วยวิศวกรรม</h1>
      <p class="converter-lead">
        แปลงหน่วยที่ใช้บ่อยในงานนิวเมติก ไฮดรอลิค และระบบลมอัด ทั้งความดัน แรง อัตราการไหล
        กำลัง แรงบิด ความยาว ปริมาตร และอุณหภูมิ ผลลัพธ์คำนวณทันทีในเครื่องของคุณ
        และมีตารางเทียบหน่วยให้เปิดดูได้โดยไม่ต้องกรอกอะไร
      </p>
    </header>

    <section class="converter-tool" aria-labelledby="converter-tool-title">
      <h2 id="converter-tool-title" class="visually-hidden">เครื่องมือแปลงหน่วย</h2>

      <div class="converter-tabs" role="group" aria-label="เลือกประเภทหน่วย">
        {CATEGORIES.map((category, index) => (
          <button
            type="button"
            class="converter-tab"
            data-category={category.id}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >{category.name}</button>
        ))}
      </div>

      <div class="converter-fields">
        <p class="converter-field">
          <label for="converter-from-value">จำนวน</label>
          <span class="converter-row">
            <input id="converter-from-value" type="number" inputmode="decimal" value="1" step="any" />
            <select id="converter-from-unit" aria-label="หน่วยต้นทาง">
              {defaultCategory.units.map((unit) => (
                <option value={unit.sym}>{unit.sym} — {unit.name}</option>
              ))}
            </select>
          </span>
        </p>

        <button type="button" class="converter-swap" id="converter-swap" aria-label="สลับหน่วยต้นทางและปลายทาง">
          <span aria-hidden="true">⇅</span>
        </button>

        <p class="converter-field">
          <label for="converter-to-value">ผลลัพธ์</label>
          <span class="converter-row">
            <output id="converter-to-value" for="converter-from-value converter-from-unit converter-to-unit">—</output>
            <select id="converter-to-unit" aria-label="หน่วยปลายทาง">
              {defaultCategory.units.map((unit, index) => (
                <option value={unit.sym} selected={index === 1}>{unit.sym} — {unit.name}</option>
              ))}
            </select>
          </span>
        </p>
      </div>

      <p class="converter-summary" id="converter-summary" aria-live="polite"></p>
      <noscript>
        <p class="converter-noscript">
          เครื่องมือแปลงหน่วยต้องใช้ JavaScript — ดูค่าเทียบหน่วยได้จากตารางด้านล่างนี้
        </p>
      </noscript>
    </section>

    <section class="converter-quick" aria-labelledby="converter-quick-title">
      <h2 id="converter-quick-title">ค่าแปลงหน่วยที่ค้นหาบ่อย</h2>
      <p class="converter-note">
        1 MPa = 10 bar · 1 bar = 14.504 psi · 1 kgf = 9.80665 N · 1 L/s = 2.119 CFM · 1 m³/h = 0.5886 CFM · 1 GPM = 3.785 L/min
      </p>
      <div class="converter-quick-grid">
        {QUICK_ANSWERS.map((quick) => (
          <div class="converter-quick-card" id={quick.id}>
            <h3>แปลง {quick.title}</h3>
            <table>
              <thead>
                <tr><th scope="col">{quick.from}</th><th scope="col">{quick.to}</th></tr>
              </thead>
              <tbody>
                {quick.rows.map(([from, to]) => (
                  <tr><th scope="row">{from} {quick.from}</th><td>{to} {quick.to}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        ))}
      </div>
    </section>

    <section class="converter-tables" aria-labelledby="converter-tables-title">
      <h2 id="converter-tables-title">ตารางเทียบหน่วยที่ใช้บ่อย</h2>

      {CATEGORIES.filter((category) => !category.temperature).map((category) => (
        <div class="converter-table-block" id={`table-${category.id}`}>
          <h3>ตารางแปลงหน่วย{category.name}</h3>
          <div class="converter-table-scroll">
            <table>
              <caption class="visually-hidden">ตารางเทียบหน่วย{category.name} เทียบกับ {category.base}</caption>
              <thead>
                <tr>
                  <th scope="col">หน่วย</th>
                  <th scope="col">ชื่อเต็ม</th>
                  <th scope="col">ค่าเทียบเท่า</th>
                </tr>
              </thead>
              <tbody>
                {category.units.map((unit) => (
                  <tr>
                    <th scope="row">{unit.sym}</th>
                    <td>{unit.name}</td>
                    <td>1 {unit.sym} = {fmt(unit.factor)} {category.base}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}

      <div class="converter-table-block">
        <h3>อุณหภูมิ</h3>
        <div class="converter-table-scroll">
          <table>
            <caption class="visually-hidden">ตารางเทียบอุณหภูมิ องศาเซลเซียส องศาฟาเรนไฮต์ และเคลวิน</caption>
            <thead>
              <tr>
                <th scope="col">°C</th>
                <th scope="col">°F</th>
                <th scope="col">K</th>
              </tr>
            </thead>
            <tbody>
              {TEMPERATURE_ROWS.map((row) => (
                <tr>
                  <th scope="row">{row.c}</th>
                  <td>{row.f}</td>
                  <td>{row.k}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="converter-note">
          °F = (°C × 9 ÷ 5) + 32 และ K = °C + 273.15 — อุณหภูมิแปลงด้วยการบวกลบค่าคงที่
          ไม่ใช่การคูณอัตราส่วนเหมือนหน่วยอื่น
        </p>
      </div>
    </section>

    <section class="converter-faq" aria-labelledby="converter-faq-title">
      <h2 id="converter-faq-title">คำถามที่พบบ่อย</h2>

      {FAQ.map((item) => (
        <Fragment>
          <h3>{item.q}</h3>
          <p>{item.a}</p>
        </Fragment>
      ))}
    </section>

    <section class="converter-related" aria-labelledby="converter-related-title">
      <h2 id="converter-related-title">อ่านต่อ</h2>
      <ul>
        <li><a href="/air-compressor/">เครื่องอัดอากาศ หรือเครื่องอัดลม มีกี่ประเภท</a> — วิธีคำนวณอัตราการผลิตลมอัดให้พอกับโรงงาน</li>
        <li><a href="/aftercoolers-factory/">Aftercooler คืออะไร</a> — วิธีคำนวณอุณหภูมิลมขาออกหลังระบายความร้อน</li>
        <li><a href="/pneumatic/">อุปกรณ์นิวเมติกส์ SMC, FESTO, Norgren</a> — กระบอกลม วาล์ว ข้อต่อลม และชุดปรับปรุงคุณภาพลม ขอราคาได้ทาง LINE</li>
        <li><a href="/hydraulic/">อุปกรณ์ไฮดรอลิค</a> — ปั๊ม วาล์ว และกระบอกไฮดรอลิค</li>
      </ul>
    </section>
  </article>
</BaseLayout>

